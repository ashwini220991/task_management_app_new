<%= form_with(model: task, local: true) do |form| %>
  <% if task.errors.any? %>
    <div class="alert alert-danger">
      <ul>
        <% task.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :title, class: "form-label" %>
    <%= form.text_field :title, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :description, class: "form-label" %>
    <%= form.text_area :description, class: "form-control" %>
  </div>

  <% unless task.new_record? %>
    <div class="mb-3">
      <%= form.label :completed, "Task Status", class: "form-label fw-bold" %>

      <%= form.select :completed,
        options_for_select(
          [
            ["Pending", false],
            ["Completed", true]
          ],
          task.completed
        ),
        {},
        class: "form-select" %>
    </div>
  <% end %>

  <% if task.completed_at.present? %>
    <div class="mb-3">
      <label class="form-label">Completed At</label>
      <input type="text"
             class="form-control"
             value="<%= task.completed_at.strftime('%d %b %Y %I:%M %p') %>"
             readonly>
    </div>
  <% end %>

  <div>
    <%= form.submit class: "btn btn-primary" %>
  </div>
<% end %>