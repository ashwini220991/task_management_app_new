<div class="card shadow-lg border-0 rounded-4 p-4">
  <%= form_with(model: @task, local: true) do |f| %>

    <% if @task.present? && @task.errors.any? %>
      <div class="alert alert-danger">
        <h5>Please fix these errors:</h5>
        <ul class="mb-0">
          <% @task.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="mb-3">
      <%= f.label :title, class: "form-label fw-bold" %>
      <%= f.text_field :title, class: "form-control form-control-lg" %>
    </div>

    <div class="mb-3">
      <%= f.label :description, class: "form-label fw-bold" %>
      <%= f.text_area :description, rows: 5, class: "form-control" %>
    </div>

    <div class="d-flex gap-2">
      <%= f.submit class: "btn btn-primary" %>
      <%= link_to "Back", tasks_path, class: "btn btn-secondary" %>
    </div>

  <% end %>
</div>